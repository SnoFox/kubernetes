{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "America/Los_Angeles",
  "addLabels": [
    "automated"
  ],
  "statusCheckNames": {
    "minimumReleaseAge": null
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/.*\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/^values/.*\\.ya?ml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^argo/.*\\.ya?ml$/"
    ]
  },
  "crossplane": {
    "managerFilePatterns": [
      "/^apps/crossplane/providers.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Group updates by app directory and update type",
      "matchFileNames": [
        "apps/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": "{{parentDir}} {{updateType}} updates",
      "groupSlug": "{{parentDir}}-{{updateType}}"
    },
    {
      "description": "Group updates in values directory by update type",
      "matchFileNames": [
        "values/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": "values {{updateType}} updates",
      "groupSlug": "values-{{updateType}}"
    },
    {
      "description": "Auto-merge minor-level changes after burn-in",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": false,
      "minimumReleaseAge": "7 days",
      "automergeSchedule": "* 8-17 * * 1-5",
      "addLabels": [
        "auto-merge"
      ]
    },
    {
      "description": "Auto-merge patch-level changes",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "branch",
      "automergeStrategy": "squash",
      "platformAutomerge": false,
      "automergeSchedule": "* 8-17 * * 1-5",
      "addLabels": [
        "auto-merge"
      ]
    },
    {
      "description": "Auto-merge digest updates for nginx-unprivileged",
      "matchPackageNames": [
        "**/nginx-unprivileged",
        "**/dgtlmoon/sockpuppetbrowser"
      ],
      "matchUpdateTypes": [
        "digest", "pinDigest"
      ],
      "automerge": true,
      "automergeType": "branch",
      "automergeStrategy": "squash",
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge digest pins",
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "branch",
      "automergeStrategy": "squash",
      "platformAutomerge": true
    },
    {
      "description": "8gears' Harbor registry publishes no release timestamps; without this the n8n chart never passes minimumReleaseAge",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "8gears.container-registry.com/library/n8n"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "quay.io's OCI chart registry publishes no release timestamps, so cert-manager never passes minimumReleaseAge. Look versions up in Jetstack's classic Helm repo instead (same versions, with timestamps); Argo still pulls the chart from quay.io",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/jetstack/charts/cert-manager"
      ],
      "overrideDatasource": "helm",
      "overridePackageName": "cert-manager",
      "registryUrls": [
        "https://charts.jetstack.io"
      ]
    },
    {
      "description": "xpkg.crossplane.io publishes no release timestamps, so the digest-pinned crossplane providers never pass minimumReleaseAge. Stay on the docker datasource (needed for the digest) and allow updates without a timestamp",
      "matchManagers": [
        "crossplane"
      ],
      "matchPackageNames": [
        "xpkg.crossplane.io/**"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Ignore the tblflp Minecraft images on registry.tblflp.zone: Renovate can't look them up (no-result), which logs a WARN every run",
      "matchPackageNames": [
        "registry.tblflp.zone/tblflp-*"
      ],
      "enabled": false
    },
    {
      "description": "Karakeep's chrome sidecar on gcr.io/zenika-hub can't be looked up (no-result), which would log a WARN every run. Tag 124 is frozen upstream; karakeep itself moved to ghcr.io/karakeep-app/karakeep-chrome",
      "matchPackageNames": [
        "gcr.io/zenika-hub/alpine-chrome"
      ],
      "enabled": false
    },
    {
      "description": "CNPG postgres images live on ghcr.io, which has no release timestamps, so minors would be held forever. Let minors through without a timestamp (they still automerge in the daytime window via the minor rule; no 7-day bake is possible). Majors (e.g. 17 -> 18 runs pg_upgrade) only ever open an MR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Never automerge a PostgreSQL major upgrade",
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "description": "CloudNativePG Cluster spec.imageName: the kubernetes manager only reads image: keys. Recipe from cloudnative-pg/postgres-containers; the build timestamp is optional so plain tags like 17.5 parse too. The flavour/OS suffix (e.g. system-trixie) is a compatibility group, so Renovate never switches base OS",
      "customType": "regex",
      "managerFilePatterns": [
        "/^(apps|values)/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "imageName: (?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:-(?<patch>\\d{12}))?(?:-(?<compatibility>\\S+))?$",
      "autoReplaceStringTemplate": "imageName: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "description": "Track upstream n8n image version in values/n8n.yml independent of the helm chart version",
      "customType": "regex",
      "managerFilePatterns": [
        "/^values/n8n\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\n  tag: (?<currentValue>[^\\n]+)"
      ],
      "depNameTemplate": "n8nio/n8n",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "n8n-io/n8n",
      "extractVersionTemplate": "^n8n@(?<version>.+)$"
    }
  ],
  "prCreation": "immediate"
}
